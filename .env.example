# App tự thu thập từ Wikidata + Wikipedia — KHÔNG cần API key.
# File này tuỳ chọn; các giá trị dưới đây là mặc định hợp lý.

# Ngôn ngữ ưu tiên cho nhãn + bài Wikipedia (vi, en, ...)
WIKI_LANG=vi
# Mã locale để ghép link tìm kiếm JustWatch (vn, us, ...)
WATCH_REGION=vn
# User-Agent gửi tới Wikidata/Wikipedia (nên ghi mô tả + liên hệ)
USER_AGENT=PhimAnhApp/1.0 (personal movie collection)
# Khóa bí mật phiên Flask (đổi khi triển khai thật)
FLASK_SECRET_KEY=changeme123
# Cổng chạy ứng dụng
PORT=5000
